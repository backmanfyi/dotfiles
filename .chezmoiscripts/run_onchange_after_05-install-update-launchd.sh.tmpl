{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Install a launchd agent that polls chezmoi for pending updates every 15
# minutes and writes a tmux-readable indicator file.
set -euo pipefail

PLIST="${HOME}/Library/LaunchAgents/fyi.backman.chezmoi-check.plist"
SCRIPT="{{ .chezmoi.homeDir }}/.config/tmux/scripts/check-updates.sh"

mkdir -p "${HOME}/Library/LaunchAgents"

cat > "${PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>fyi.backman.chezmoi-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>${SCRIPT}</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>${HOME}/.cache/chezmoi-check.log</string>
  <key>StandardErrorPath</key><string>${HOME}/.cache/chezmoi-check.log</string>
</dict>
</plist>
EOF

echo "==> Installing chezmoi update-check launchd agent"
launchctl unload "${PLIST}" 2>/dev/null || true
launchctl load "${PLIST}"
echo "==> Update-check agent installed (runs every 15 minutes)"
{{ end -}}
