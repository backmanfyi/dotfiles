# NvimOpen file associations
# Applied by run_onchange_after_07-setup-duti.sh
# Format: <bundle-id>  <UTI-or-extension>  <role>

# ── System UTIs (reliable, covers all files of this type) ───────────────────
com.larsbackman.nvimopen    public.plain-text                        all
com.larsbackman.nvimopen    public.comma-separated-values-text       all
com.larsbackman.nvimopen    public.json                              all
com.larsbackman.nvimopen    public.xml                               all
com.larsbackman.nvimopen    public.shell-script                      all
com.larsbackman.nvimopen    public.log                               all
