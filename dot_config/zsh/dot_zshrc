# Cache helper: regenerates only when the binary is newer than the cached output.
# Usage: _zsh_cache <cache-name> <binary-for-mtime-check> <cmd> [args...]
_zsh_cache() {
  local name="$1" bin="$2"; shift 2
  local cache="$ZSH_CACHE_DIR/init_${name}.zsh"
  local bin_path && bin_path=$(whence -p "$bin" 2>/dev/null)
  if [[ ! -f "$cache" ]] || { [[ -n "$bin_path" ]] && [[ "$bin_path" -nt "$cache" ]]; }; then
    "$@" > "$cache" 2>/dev/null
  fi
  source "$cache"
}

# Completions: cache to files, regenerate when binary changes
_zsh_completion_cache() {
  local name="$1" bin="$2"; shift 2
  local cache="$ZSH_CACHE_DIR/completion_${name}.zsh"
  local bin_path && bin_path=$(whence -p "$bin" 2>/dev/null)
  if [[ ! -f "$cache" ]] || { [[ -n "$bin_path" ]] && [[ "$bin_path" -nt "$cache" ]]; }; then
    "$@" > "$cache" 2>/dev/null
  fi
  source "$cache"
}

